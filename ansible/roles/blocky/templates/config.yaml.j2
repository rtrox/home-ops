---
ports:
  dns: 53
  http: 80
  https: 443

upstreams:
  groups:
    default:
      - tcp-tls:1.1.1.1:853
      - tcp-tls:1.0.0.1:853
      - https://cloudflare-dns.com/dns-query

ede:
  enable: true

blocking:
  denylists:
    ads:
      - https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
  allowlists:
    ads:
      - |
        comcastathena.demdex.net
        dl.cws.xfinity.com
        login.xfinity.com
        oauth.xfinity.com
        business.comcast.com
        assets.adobedtm.com
        static.digital.business.comcast.com
        dpm.demdex.net
        comcastresidentialservices.tt.omtrdc.net
        www.reddit.com
        discourse.pi-hole.net
        img04.en25.com
        xchat.xfinity.com
        script.crazyegg.com
        assets.bounceexchange.com
        api.bounceexchange.com
        events.bouncex.net
        media.xchat.xfinity.com
        files.slack.com
        slack.com
        www.kqzyfj.com
        kqzyfj.com
        cdn.heapanalytics.com
        # Allow Google Ads
        www.googleadservices.com
        dartsearch.net
        www.googletagmanager.com
        www.googletagservices.com
        ad.doubleclick.net
        clickserve.dartsearch.net
        t.myvisualiq.net
        stashdb.org
        segment.com
        s2.bl-1.com

  clientGroupsBlock:
    default:
      - ads
  blockType: zeroIp

clientLookup:
  upstream: {{ blocky_upstream }}
  singleNameOrder:
    - 2
    - 1

caching:
  minTime: 5m
  cacheTimeNegative: 30m
  prefetching: true

# Shared with the other DNS host through the keepalived VIP (see roles/valkey).
# Not required: if Valkey is unreachable, Blocky keeps resolving on its own cache.
redis:
  address: "{{ blocky_redis_address }}"
  password: "{{ blocky_redis_password }}"
  database: {{ blocky_redis_database }}
  required: false

# One JSON line per query on stdout. Docker's journald driver keeps it in the
# in-RAM journal (roles/journald), and Alloy ships it to Loki (roles/alloy),
# so query logs never touch the disk.
log:
  level: info
  format: json

queryLog:
  type: {{ 'console' if blocky_query_log | bool else 'none' }}

prometheus:
  enable: true
  path: /metrics
