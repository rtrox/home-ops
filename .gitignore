# Ignore any Infra Configs
**/*talosconfig*
**/*kubeconfig*

# .age-keys contains decrypted private keys for age
**/.age-keys

# ensure sopsifier files don't leak
**/.decrypted~*

**/.DS_Store

# Terraform
## Local .terraform directories
**/.terraform/*

## .tfstate files
*.tfstate
*.tfstate.*

## terraform plan output
*tfplan*

## Override files: only ever temporary (e.g. a state move's backend override)
override.tf
*_override.tf

# Other files
kubeconfig

# Ansible Inventory files
inventory.yml
inventory.yaml
inventory.ini

# Claude Code local files (shared agents and settings are tracked)
.claude/*
!.claude/agents/
!.claude/settings.json

# Node modules (prettier)
node_modules/

# Python
.venv/
.pytest_cache/
__pycache__/
