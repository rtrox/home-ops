# Ignore any Infra Configs
**/*talosconfig*
**/*kubeconfig*

# .age-keys contains decrypted private keys for age
**/.age-keys

# ensure sopsifier files don't leak
**/.decrypted~*

**/.DS_Store

# Terraform
## Local .terraform directories
**/.terraform/*

## .tfstate files
*.tfstate
*.tfstate.*

## terraform plan output
*tfplan*

# Other files
kubeconfig

# Ansible Inventory files
inventory.yml
inventory.yaml
inventory.ini

# Flux local temporary files
.flux-worktree/
flux-diff.patch

# Claude Code local files (the upgrade-steward skill and its settings are versioned)
.claude/*
!.claude/skills/
!.claude/upgrade-steward/

# Node modules (prettier)
node_modules/

# Python
.venv/
.pytest_cache/
__pycache__/
