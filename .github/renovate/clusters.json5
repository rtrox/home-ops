{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Separate PRs for main cluster",
      matchFileNames: ["**/cluster-cd/aps/bitty/**", "**/cluster-apps/bitty/**", "**/clusters/bitty/**"],
      additionalBranchPrefix: "bitty-",
    },
    {
      description: "Separate PRs for main cluster",
      matchFileNames: ["**/cluster-apps/mini/**", "**/clusters/mini/**"],
      additionalBranchPrefix: "mini-",
    },
  ],
}
