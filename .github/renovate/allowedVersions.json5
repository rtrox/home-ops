{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/calibre-web"],
      allowedVersions: "<1",
    },
    {
      description: "Hold Rook-Ceph at v1.19.x on chongus/bitty — v1.20 (Tentacle) is flaky; revisit after the bare-metal rebuild. Mini tracks true latest instead (see cluster-apps/mini/rook-ceph/rook-ceph/{operator,cluster}/ocirepository.yaml), so it's excluded here.",
      matchFileNames: ["**/cluster-apps/chongus/**", "**/cluster-apps/bitty/**"],
      matchPackageNames: [
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
      ],
      allowedVersions: "<=1.19.6",
    },
  ],
}
