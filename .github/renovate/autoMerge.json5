{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The "Protect main" ruleset requires a pull request (and signed commits)
  // for every change to main, with no bypass actors, so branch automerge --
  // which pushes straight to main -- can never succeed. Automerge via PRs
  // instead, merged by Renovate itself through the API (not GitHub's native
  // auto-merge) as a squash, which GitHub signs.
  automergeType: "pr",
  platformAutomerge: false,
  automergeStrategy: "squash",
  packageRules: [
    {
      // packageRules override top-level settings, and the shared
      // github>rtrox/renovate-config preset (extended before this file) sets
      // automergeType: "branch" in its own packageRules for minor/patch/digest
      // and github-actions updates -- re-assert PR automerge after it.
      description: "Automerge via PRs, never branches (see top-level comment)",
      matchPackageNames: ["*"],
      automergeType: "pr",
    },
    {
      description: "Auto merge container digests",
      matchDatasources: ["docker"],
      automerge: true,
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["ghcr.io/onedr0p{/,}**", "ghcr.io/bjw-s{/,}**"],
      ignoreTests: true,
    },
    {
      description: "Auto merge KPS minors and patches",
      matchDatasources: ["helm"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["kube-prometheus-stack"],
      ignoreTests: false,
    },
    {
      description: "Auto merge all patches",
      automerge: true,
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      ignoreTests: false,
    },
    {
      // The chart comes from an OCI registry, so Renovate sees it as a docker
      // package, not a helm one. Match every update type: unlike the helm
      // datasource, docker can also produce digest/pin updates.
      description: "Never Automerge Cilium",
      matchDatasources: ["docker"],
      automerge: false,
      matchPackageNames: ["quay.io/cilium/charts/cilium"],
      ignoreTests: false,
    },
    {
      // Temporary hold: Gateway API 1.7 stays held until Envoy Gateway and
      // Cilium support it. Drop this rule once they do. Has to stay after
      // "Auto merge all patches" to win. "gateway-api-crd" PRs are covered
      // too: that's only the depName of the flux GitRepository, whose
      // packageName is kubernetes-sigs/gateway-api.
      description: "Hold Gateway API 1.7 until Envoy Gateway and Cilium support it",
      automerge: false,
      matchPackageNames: ["kubernetes-sigs/gateway-api"],
    },
    {
      // CNPG 1.32.0 removes native (in-tree) Barman Cloud support. postgres17's
      // backups have moved to the Barman Cloud plugin (cloudnative-pg-barman-plugin
      // + the ObjectStore in cloudnative-pg/cluster); confirm that migration is
      // live, and check the plugin's CNPG compatibility, before upgrading.
      description: "Never Automerge CloudNativePG",
      matchDatasources: ["docker"],
      automerge: false,
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/charts/cloudnative-pg",
        "ghcr.io/cloudnative-pg/charts/plugin-barman-cloud",
      ],
    },
    {
      // n8n runs one-way database migrations on startup, and Renovate follows
      // every image tag, including ones upstream still marks as prerelease
      // (2.47.x and the 3.x line while its stable tag stays on 2.46). Review
      // each bump, and check the release is not flagged as a prerelease.
      description: "Never Automerge n8n",
      matchDatasources: ["docker"],
      automerge: false,
      matchPackageNames: ["ghcr.io/n8n-io/n8n", "ghcr.io/n8n-io/runners"],
      prBodyNotes: [
        ":warning: **Manual Review Required**: n8n migrates its database on startup and the migration can't be rolled back. Check the [n8n releases](https://github.com/n8n-io/n8n/releases) and confirm this version is not flagged as a prerelease, and that the `stable` tag has reached it.",
      ],
    },
    {
      description: "Hold n8n major updates until approved on the Dependency Dashboard",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major"],
      matchPackageNames: ["ghcr.io/n8n-io/n8n", "ghcr.io/n8n-io/runners"],
      dependencyDashboardApproval: true,
    },
    {
      // Gotenberg 9 removes the /forms/pdfengines routes and renames the pdfa
      // form field; paperless-ngx (via gotenberg-client) still uses the old API,
      // so 9.x would break Office/email ingestion. Stay on 8.x until paperless-ngx
      // supports 9, then drop this rule.
      description: "Hold Gotenberg on 8.x until paperless-ngx supports 9",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/gotenberg/gotenberg"],
      allowedVersions: "<9",
    },
    {
      description: "Never Automerge qbittorrent",
      matchDatasources: ["docker"],
      automerge: false,
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      // Only open a PR once someone approves it on the Dependency Dashboard:
      // new versions may not yet be on private trackers' client allowlists.
      dependencyDashboardApproval: true,
      prBodyNotes: [
        ":warning: **Manual Review Required**: Check [qbittorrent changelog](https://github.com/qbittorrent/qBittorrent/blob/master/Changelog) and [libtorrent releases](https://github.com/arvidn/libtorrent/releases) for breaking changes before merging.",
        ":no_entry: **Tracker Compatibility**: Check that the new version is on your trackers' approved-client lists before merging.",
      ],
    },
    {
      description: "Never Automerge Kubernetes",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["kubernetes/kubernetes"],
      automerge: false,
      ignoreTests: false,
      prBodyNotes: [
        ":warning: **Manual Review Required**: Confirm the new Kubernetes version is supported by the pinned Talos version in the same talconfig.yaml before merging -- check the [Talos support matrix](https://www.talos.dev/latest/introduction/support-matrix/). A mismatched pin will fail `talhelper genconfig`.",
      ],
    },
    {
      // talosVersion in talconfig.yaml is tracked via an inline `# renovate:`
      // comment against this same package (see the depName= annotation above
      // talosVersion), so this rule also gates the actual Talos version bump,
      // not just the installer image.
      description: "Never Automerge Talos",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/installer"],
      automerge: false,
      ignoreTests: false,
      prBodyNotes: [
        ":warning: **Manual Review Required**: Confirm the new Talos version still supports the pinned Kubernetes version in the same talconfig.yaml before merging -- check the [Talos support matrix](https://www.talos.dev/latest/introduction/support-matrix/). After merging, also update `talos.version` in the matching tuppr `TalosUpgrade` (system-upgrade/tuppr/upgrades/talos.yaml) -- it's kept in sync by hand, not auto-updated by this PR.",
      ],
    },
    {
      // Rook's chart version keeps major=1 forever (v1.19 -> v1.20 -> v1.21
      // are semver *minor* bumps), so matchUpdateTypes: ["major"] would never
      // fire here -- same trap as Kubernetes above. Block unconditionally
      // instead of trying to classify by update type.
      description: "Never Automerge Rook-Ceph",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: [
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
        "quay.io/ceph/ceph",
      ],
      automerge: false,
      ignoreTests: false,
      prBodyNotes: [
        ":warning: **Manual Review Required**: Confirm the new Rook/Ceph version is a supported pairing before merging -- check [Rook's maintenance and support matrix](https://rook.io/docs/rook/latest-release/Getting-Started/maintenance-and-support/) and the [Ceph upgrade guide](https://rook.io/docs/rook/latest-release/Upgrade/ceph-upgrade/) for known-bad patch versions (e.g. avoid Ceph v20.2.0 -- data-corruption bug with read affinity enabled, use v20.2.1+).",
      ],
    },
  ],
}
