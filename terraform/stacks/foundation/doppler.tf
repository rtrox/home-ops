# Every Doppler project, environment and config, and one write token per
# config Terraform writes to. A new cluster or site is a list entry here (and,
# if Terraform writes to it, one in terramate.tm.hcl's doppler_write_tokens),
# not clicks.
#
# Every write here uses the default provider, the owner's personal token
# (task tf:* sets DOPPLER_TOKEN). The free plan has no service accounts, and
# only a personal token can create service tokens. It also means this stack
# never depends on the write tokens it mints.
#
# Project names stay as they are until phase 3 renames them.
locals {
  # project -> description and environments. An environment's root config has
  # the environment's slug as its name; branch configs are listed under it.
  doppler_projects = {
    "ansible" = {
      description = "Secrets generated by Terraform and read by the Ansible plays (Valkey and keepalived passwords)"
      environments = {
        # Its own project, not hosts-at-home/prd: CI's token for that config
        # would read the runner's GitHub App key. One config for every site, since
        # one Ansible run can cover several; its root config is unmanaged like
        # min-ci's. Written by the dns stack; the CI tokens are in ansible_config.tf.
        prd = { name = "Production", unmanaged_root = true }
      }
    }
    "chezmoi-secrets" = {
      description = "Secrets for use in dotfiles"
      environments = {
        dot = { name = "Dotfiles - Main", branches = ["dot_desktop", "dot_laptop", "dot_wrk"] }
        dsk = { name = "Desktop" }
      }
    }
    "hosts-at-home" = {
      description = "Secrets for non-Kubernetes hosts (NAS, Pis, Proxmox). Terraform writes some here; some are added to hosts by hand."
      environments = {
        prd = { name = "HL15" }
        ci  = { name = "Continuous Integration" }
      }
    }
    "k8s-at-home" = {
      description = ""
      environments = {
        min = { name = "Mini" }
        # Secrets written by stacks CI plans (clusters/mini/README.md). A root
        # config of its own, not a branch of min: a branch inherits min's
        # secrets, and CI's plan token reads this one. Its root config is not
        # managed (unmanaged_root, below).
        min-ci = { name = "Mini CI", unmanaged_root = true }
      }
    }
    "tf-at-home" = {
      description = ""
      environments = {
        prd = { name = "Production" }
        ci  = { name = "Continuous Integration" }
        # CI's apply credentials (ci_apply.tf). Its own root config, so the ci
        # and prd tokens can't read it.
        ci-apply = { name = "CI Apply" }
        # The Doppler export job's tokens (doppler_export.tf). No CI token
        # reads it. Its root config is not managed (unmanaged_root, below).
        export = { name = "Export", unmanaged_root = true }
      }
    }
  }

  # "project/environment" -> environment.
  doppler_environments = merge([
    for project, p in local.doppler_projects : {
      for slug, env in p.environments : "${project}/${slug}" => {
        project = project
        slug    = slug
        name    = env.name
      }
    }
  ]...)

  # "project/config" -> config: each environment's root config (unless
  # unmanaged_root), then its branch configs.
  doppler_configs = merge([
    for project, p in local.doppler_projects : merge([
      for slug, env in p.environments : {
        for config in concat(try(env.unmanaged_root, false) ? [] : [slug], try(env.branches, [])) : "${project}/${config}" => {
          project     = project
          environment = slug
          name        = config
        }
      }
    ]...)
  ]...)
}

resource "doppler_project" "this" {
  for_each = local.doppler_projects

  name        = each.key
  description = each.value.description

  lifecycle {
    prevent_destroy = true
  }
}

resource "doppler_environment" "this" {
  for_each = local.doppler_environments

  project = doppler_project.this[each.value.project].name
  slug    = each.value.slug
  name    = each.value.name

  lifecycle {
    prevent_destroy = true
  }
}

# Root configs (name == environment): Doppler creates one with every
# environment, so every root config here was imported (P2-1), never
# created. The provider's create would try to set inheritance, which the free
# plan refuses.
#
# A new environment's root config is left unmanaged (unmanaged_root): an import
# block for it fails the plan, since the config doesn't exist until the
# environment is applied, and the provider's create is unproven on the free plan.
# Nothing needs it as a resource: local.doppler_config_ref names it through the
# environment, which also orders its tokens after the environment. Import it in a
# later PR if wanted.
resource "doppler_config" "this" {
  for_each = local.doppler_configs

  project     = doppler_environment.this["${each.value.project}/${each.value.environment}"].project
  environment = doppler_environment.this["${each.value.project}/${each.value.environment}"].slug
  name        = each.value.name

  lifecycle {
    prevent_destroy = true
  }
}

# "project/config" -> {project, name} for every config: the managed config, or
# an unmanaged root config's environment.
locals {
  doppler_config_keys = setunion(keys(local.doppler_configs), flatten([
    for project, p in local.doppler_projects : [
      for slug, env in p.environments : "${project}/${slug}" if try(env.unmanaged_root, false)
    ]
  ]))

  doppler_config_ref = {
    for k in local.doppler_config_keys : k => try(
      { project = doppler_config.this[k].project, name = doppler_config.this[k].name },
      { project = doppler_environment.this[k].project, name = doppler_environment.this[k].slug },
    )
  }
}

# One read/write token per config Terraform writes to, kept in tf-at-home/prd
# under the name the stacks read (local.doppler_write_tokens, generated from
# terramate.tm.hcl). Named for the consumer: the Terraform stacks, which read it
# through tf-at-home/prd.
resource "doppler_service_token" "write" {
  for_each = local.doppler_write_tokens

  project = local.doppler_config_ref[each.key].project
  config  = local.doppler_config_ref[each.key].name
  name    = "tf-stacks-write"
  access  = "read/write"

  lifecycle {
    # Every argument forces a new token: have it in Doppler before the old one
    # is revoked.
    create_before_destroy = true
  }
}

resource "doppler_secret" "write_token" {
  for_each = local.doppler_write_tokens

  project = "tf-at-home"
  config  = "prd"
  name    = each.value
  value   = doppler_service_token.write[each.key].key
}
