{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sites.schema.json",
  "title": "inventory/sites.yaml",
  "type": "object",
  "required": ["sites"],
  "additionalProperties": false,
  "properties": {
    "sites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/site" }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "ipv4": { "type": "string", "format": "ipv4", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$" },
    "cidr4": { "type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$" },
    "cidr6": { "type": "string", "pattern": "^[0-9a-f:]+/\\d{1,3}$" },
    "site": {
      "type": "object",
      "required": ["name", "status", "block"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["permanent", "temporary", "free"] },
        "block": { "$ref": "#/$defs/cidr4" },
        "ipv6": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "he_prefix": { "$ref": "#/$defs/cidr6" },
            "route48_prefix": { "$ref": "#/$defs/cidr6" }
          }
        },
        "vlans": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": { "$ref": "#/$defs/vlan" }
        },
        "firewall": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/rule" }
          }
        },
        "clusters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": {
            "type": "object",
            "required": ["slot", "pod_cidr"],
            "additionalProperties": false,
            "properties": {
              "slot": { "type": "integer", "minimum": 1, "maximum": 9 },
              "pod_cidr": { "$ref": "#/$defs/cidr4" },
              "service_cidr": { "$ref": "#/$defs/cidr4" }
            }
          }
        },
        "loadbalancer_pools": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": {
            "type": "object",
            "required": ["cidr"],
            "additionalProperties": false,
            "properties": {
              "cidr": { "$ref": "#/$defs/cidr4" },
              "moves_to": { "$ref": "#/$defs/cidr4" }
            }
          }
        }
      }
    },
    "vlan": {
      "type": "object",
      "required": ["id", "cidr"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "purpose": { "type": "string" },
        "cidr": { "$ref": "#/$defs/cidr4" },
        "router": { "$ref": "#/$defs/ipv4" },
        "dhcp": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/ipv4" },
            "end": { "$ref": "#/$defs/ipv4" }
          }
        },
        "ipv6": { "$ref": "#/$defs/cidr6" },
        "subnets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": {
            "type": "object",
            "required": ["cidr"],
            "additionalProperties": false,
            "properties": {
              "cidr": { "$ref": "#/$defs/cidr4" },
              "purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["allow", "deny"] },
        "to": { "type": "string" },
        "match": { "type": "string" }
      },
      "anyOf": [{ "required": ["to"] }, { "required": ["match"] }]
    }
  }
}
