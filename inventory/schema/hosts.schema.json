{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hosts.schema.json",
  "title": "inventory/hosts.yaml (Ansible YAML inventory)",
  "type": "object",
  "required": ["all"],
  "additionalProperties": false,
  "properties": {
    "all": {
      "type": "object",
      "required": ["children"],
      "additionalProperties": false,
      "properties": {
        "vars": { "type": "object" },
        "children": {
          "type": "object",
          "required": ["unmanaged"],
          "additionalProperties": { "$ref": "#/$defs/group" }
        }
      }
    }
  },
  "$defs": {
    "ipv4": { "type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$" },
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vars": { "type": "object" },
        "hosts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/host" }
        }
      }
    },
    "host": {
      "type": "object",
      "required": ["site", "vlan"],
      "properties": {
        "site": { "$ref": "#/$defs/key" },
        "vlan": { "$ref": "#/$defs/key" },
        "subnet": { "$ref": "#/$defs/key" },
        "address": { "$ref": "#/$defs/ipv4" },
        "ansible_host": { "$ref": "#/$defs/ipv4" },
        "dns_name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "purpose": { "type": "string" },
        "extra_addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["vlan", "address"],
            "additionalProperties": false,
            "properties": {
              "vlan": { "$ref": "#/$defs/key" },
              "address": { "$ref": "#/$defs/ipv4" }
            }
          }
        },
        "moves_to": {
          "type": "object",
          "required": ["site", "vlan", "address"],
          "additionalProperties": false,
          "properties": {
            "site": { "$ref": "#/$defs/key" },
            "vlan": { "$ref": "#/$defs/key" },
            "address": { "$ref": "#/$defs/ipv4" }
          }
        }
      }
    }
  }
}
